# Supabase — copy this file to ".env" and fill in the values from your project
# (Project settings → API). Only the public "anon" key belongs here; the
# service_role key must never reach the browser.
#
# Both are required: the site reads articles, projects and form submissions
# from the database, and the admin dashboard signs in against it. Run
# supabase/schema.sql once against the project before first use.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — override the chunked video-upload endpoint. Defaults to
# "<SITE_URL>/media/upload.php" (see octenium/README.md). Only set this if the
# media directory lives on a different host.
# VITE_MEDIA_UPLOAD_URL=https://engineering-studio.net/media/upload.php
